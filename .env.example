# Copy to `.env` only if the design system is not the sibling folder ../linarc-design-components.
# Absolute, or relative to this folder. Read by vite.config.mjs (and through it tailwind.config.js and src/style.css).
# LINARC_DS_PATH=../linarc-design-components

# Never put registry tokens here or in .npmrc (F-001). The library is consumed from source; no registry is needed.
