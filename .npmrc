# Not needed for day-to-day prototyping: the design system is consumed from the
# sibling ../linarc-design-components source via Vite aliases, not from the registry.
#
# To install @development/* packages from GitLab, set GITLAB_NPM_TOKEN in your environment
# and uncomment both lines below. Yarn fails on every command if the auth line is active
# and the variable is unset. Never commit a literal token here.
# @development:registry=https://gitlab.com/api/v4/groups/4921253/-/packages/npm/
# //gitlab.com/api/v4/groups/4921253/-/packages/npm/:_authToken=${GITLAB_NPM_TOKEN}
